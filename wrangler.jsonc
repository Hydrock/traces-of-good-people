{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traces-of-good-people",
  "compatibility_date": "2026-08-28",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "TRACES_BUCKET",
      "bucket_name": "traces-of-good-people-traces"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "traces-of-good-people-media"
    }
  ]
}
