---
import Layout from '../../layouts/Layout.astro';
import { formatTraceDate, loadApprovedTraces } from '../../lib/traces.js';

export function getStaticPaths() {
  return loadApprovedTraces().map((trace) => ({
    params: { id: trace.id },
    props: { trace },
  }));
}

const { trace } = Astro.props;
const person = trace.name || 'Anonymous';
---

<Layout
  title={`${person} — Traces of Good People`}
  description={`A trace left by ${person}${trace.location ? ` in ${trace.location}` : ''}.`}
>
  <article class="person">
    <a class="text-link person__back" href="/people"><span aria-hidden="true">←</span> All people</a>

    {trace.photoUrl && <img class="person__photo" src={trace.photoUrl} alt={`Shared by ${person}`} />}

    <div class="person__story">
      <p class="person__message">“{trace.message}”</p>
      <footer class="person__meta">
        <strong>{person}</strong>
        {trace.location && <span>{trace.location}</span>}
        <time datetime={trace.createdAt}>{formatTraceDate(trace.createdAt)}</time>
      </footer>
    </div>
  </article>
</Layout>
