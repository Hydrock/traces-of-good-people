---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import people from '../../assets/people.png';
---

<Layout
  title="People — Traces of Good People"
  description="Messages and photographs from good people met around the world."
  titleKey="peopleMetaTitle"
  descriptionKey="peopleMetaDescription"
>
  <header class="collection-header">
    <figure class="collection-header__illustration">
      <Image
        src={people}
        alt="A diverse group of travellers"
        data-i18n-alt="peopleImageAlt"
        loading="eager"
      />
    </figure>

    <div>
      <p class="eyebrow" data-i18n="peopleEyebrow">People</p>
      <h1 data-i18n="peopleTitle">Traces left along the way.</h1>
    </div>
  </header>

  <ol class="people-grid" data-people-list></ol>
  <p class="empty-state" data-people-status data-i18n="peopleLoading">Loading traces…</p>

  <template id="person-card-template">
    <li><a class="person-card"><div class="person-card__body"><p class="person-card__message"></p><div class="person-card__meta"></div></div></a></li>
  </template>

  <script>
    const list = document.querySelector('[data-people-list]');
    const status = document.querySelector('[data-people-status]');
    const template = document.querySelector('#person-card-template');
    const i18n = window.siteI18n;
    let traces = null;
    let loadError = false;

    function renderTraces() {
      if (loadError) {
        status.textContent = i18n.t('peopleError');
        return;
      }
      if (!traces) return;
      list.replaceChildren();
      status.textContent = traces.length ? '' : i18n.t('peopleEmpty');

      for (const trace of traces) {
        const item = template.content.firstElementChild.cloneNode(true);
        const link = item.querySelector('a');
        link.href = `/people/${trace.id}`;
        if (!trace.photoUrl) link.classList.add('person-card--text');
        else {
          const image = document.createElement('img');
          image.src = trace.photoUrl;
          image.alt = '';
          image.loading = 'lazy';
          link.prepend(image);
        }
        item.querySelector('.person-card__message').textContent = `“${trace.message}”`;
        const meta = item.querySelector('.person-card__meta');
        for (const value of [trace.name || i18n.t('anonymous'), trace.location, i18n.formatDate(trace.createdAt)].filter(Boolean)) {
          const span = document.createElement('span');
          span.textContent = value;
          meta.append(span);
        }
        list.append(item);
      }
    }

    try {
      const response = await fetch('/api/traces');
      if (!response.ok) throw new Error();
      ({ traces } = await response.json());
      renderTraces();
    } catch {
      loadError = true;
      renderTraces();
    }

    window.addEventListener('site-language-change', renderTraces);
  </script>
</Layout>
