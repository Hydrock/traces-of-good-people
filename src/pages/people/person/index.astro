---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="A person — Traces of Good People"
  description="A trace left by a good person met along the way."
>
  <article class="person">
    <a class="text-link person__back" href="/people"><span aria-hidden="true">←</span> All people</a>

    <p class="empty-state" data-person-status>Loading trace…</p>
    <img class="person__photo" data-person-photo hidden />
    <div class="person__story" data-person-story hidden>
      <p class="person__message"></p>
      <footer class="person__meta">
        <strong></strong>
        <span data-person-location></span>
        <time></time>
      </footer>
    </div>
  </article>
  <script>
    const status = document.querySelector('[data-person-status]');
    const story = document.querySelector('[data-person-story]');
    const id = location.pathname.split('/').filter(Boolean).at(-1);
    try {
      const response = await fetch(`/api/traces/${encodeURIComponent(id || '')}`);
      if (!response.ok) throw new Error();
      const trace = await response.json();
      const person = trace.name || 'Anonymous';
      document.title = `${person} — Traces of Good People`;
      document.querySelector('.person__message').textContent = `“${trace.message}”`;
      document.querySelector('.person__meta strong').textContent = person;
      const location = document.querySelector('[data-person-location]');
      location.textContent = trace.location || '';
      location.hidden = !trace.location;
      const time = document.querySelector('.person__meta time');
      time.dateTime = trace.createdAt;
      time.textContent = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(trace.createdAt));
      if (trace.photoUrl) {
        const photo = document.querySelector('[data-person-photo]');
        photo.src = trace.photoUrl;
        photo.alt = `Shared by ${person}`;
        photo.hidden = false;
      }
      status.hidden = true;
      story.hidden = false;
    } catch {
      status.textContent = 'Trace not found.';
    }
  </script>
</Layout>
