---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import notFound from '../assets/404.png';
---

<Layout
  title="Not found — Traces of Good People"
  description="The requested trace could not be found."
  titleKey="notFoundMetaTitle"
  descriptionKey="notFoundMetaDescription"
>
  <section class="page not-found">
    <div>
      <p class="eyebrow" data-i18n="notFoundEyebrow">Not found</p>
      <h1 data-i18n="notFoundTitle">This trace could not be found.</h1>
      <p class="intro" data-i18n="notFoundIntro">
        Check the address from the QR code, or return to the project homepage.
      </p>
      <a class="text-link" href="/"><span aria-hidden="true">←</span> <span data-i18n="backHome">Back home</span></a>
    </div>

    <figure class="not-found__illustration">
      <Image
        src={notFound}
        alt="A lost suitcase beside an empty signpost"
        data-i18n-alt="notFoundImageAlt"
        loading="eager"
      />
    </figure>
  </section>
</Layout>
