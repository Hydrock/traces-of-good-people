---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import notFound from '../assets/404.png';
---

<Layout
  title="Not found — Traces of Good People"
  description="The requested trace could not be found."
>
  <section class="page not-found">
    <div>
      <p class="eyebrow">Not found</p>
      <h1>This trace could not be found.</h1>
      <p class="intro">
        Check the address from the QR code, or return to the project homepage.
      </p>
      <a class="text-link" href="/"><span aria-hidden="true">←</span> Back home</a>
    </div>

    <figure class="not-found__illustration">
      <Image
        src={notFound}
        alt="A lost suitcase beside an empty signpost"
        loading="eager"
      />
    </figure>
  </section>
</Layout>
