---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import letter from '../../assets/letter.png';
import sent from '../../assets/sended.png';

---

<Layout
  title="A gift — Traces of Good People"
  description="A small gift travelling between good people."
  titleKey="giftMetaTitle"
  descriptionKey="giftMetaDescription"
>
  <section class="language-gate" data-language-gate aria-labelledby="language-gate-heading">
    <div class="language-gate__inner">
      <p class="eyebrow">Traces of Good People</p>
      <h1 id="language-gate-heading" tabindex="-1" data-gate-i18n="welcome">Welcome.</h1>
      <p data-gate-i18n="chooseLanguage">Choose your language</p>
      <div class="language-gate__options">
        <button type="button" data-language-choice="en"><span aria-hidden="true">🇬🇧</span> English</button>
        <button type="button" data-language-choice="ru"><span aria-hidden="true">🇷🇺</span> Русский</button>
        <button type="button" data-language-choice="es"><span aria-hidden="true">🇪🇸</span> Español</button>
        <button type="button" data-language-choice="fr"><span aria-hidden="true">🇫🇷</span> Français</button>
        <button type="button" data-language-choice="pt"><span aria-hidden="true">🇵🇹</span> Português</button>
        <button type="button" data-language-choice="ar"><span aria-hidden="true">🇸🇦</span> العربية</button>
        <button type="button" data-language-choice="zh"><span aria-hidden="true">🇨🇳</span> 中文</button>
        <button type="button" data-language-choice="hi"><span aria-hidden="true">🇮🇳</span> हिन्दी</button>
      </div>
    </div>
  </section>

  <p class="form-status" data-gift-status role="status" data-i18n="giftLoading">Loading gift…</p>
  <div data-gift-content hidden>
  <article class="trace-intro">
    <div class="trace-intro__content">
      <p class="trace-number" data-trace-number></p>
      <h1 data-i18n="heading">This gift found its way to you.</h1>
      <p class="intro" data-i18n="intro">
        It is part of a small travelling project about chance meetings and the
        good people we find along the way.
      </p>
    </div>

    <figure class="trace-illustration">
      <Image
        src={letter}
        alt="A postcard and pencil"
        data-i18n-alt="giftImageAlt"
        loading="eager"
      />
    </figure>
  </article>

  <section class="feedback" aria-labelledby="feedback-heading">
    <div class="feedback-heading">
      <h2 id="feedback-heading" data-i18n="formHeading">Leave your trace</h2>
      <p data-i18n="formIntro">Share as much or as little as you like.</p>
    </div>

    <form id="trace-form" action="/api/traces" method="post" enctype="multipart/form-data">
      <input type="hidden" name="gift" />

      <div class="field">
        <label for="name">
          <span data-i18n="nameLabel">Name or nickname</span>
          <small data-i18n="optional">optional</small>
        </label>
        <input id="name" name="name" type="text" maxlength="80" autocomplete="nickname" />
      </div>

      <div class="field">
        <label for="location">
          <span data-i18n="locationLabel">City and country</span>
          <small data-i18n="optional">optional</small>
        </label>
        <input id="location" name="location" type="text" maxlength="120" autocomplete="address-level2" />
      </div>

      <div class="field">
        <label for="message" data-i18n="messageLabel">Your message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          maxlength="1000"
          aria-describedby="message-help"
          required
        ></textarea>
        <small id="message-help" data-i18n="messageHelp">
          Need an idea? Tell me something about yourself, what made you smile
          today, or what a traveller should see in your city.
        </small>
      </div>

      <div class="field">
        <label for="photo">
          <span data-i18n="photoLabel">Photo</span>
          <small data-i18n="optional">optional</small>
        </label>
        <input
          id="photo"
          name="photo"
          type="file"
          accept="image/jpeg,image/png,image/webp"
        />
        <small data-i18n="photoHelp">Choose a photo or take one with your camera.</small>
      </div>

      <aside class="privacy-notice">
        <h3 data-i18n="privacyHeading">Before you submit</h3>
        <p data-i18n="privacyText">
          Do not share sensitive or private information such as your home
          address, phone number, identification documents, passwords, or
          financial information.
        </p>
      </aside>

      <label class="consent">
        <input type="checkbox" name="consent" value="yes" required />
        <span data-i18n="consentLabel">
          I understand that my message and photo may become publicly visible
          after moderation.
        </span>
      </label>

      <button type="submit" data-i18n="submit">Send trace</button>
      <p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
      <figure class="form-success-illustration" data-success-illustration hidden>
        <Image src={sent} alt="" loading="lazy" />
      </figure>
    </form>
  </section>

  </div>
  <script>
    const i18n = window.siteI18n;
    const giftStatus = document.querySelector('[data-gift-status]');
    const giftContent = document.querySelector('[data-gift-content]');
    const giftCode = location.pathname.split('/').filter(Boolean).at(-1)?.toUpperCase();
    const giftResponse = await fetch(`/api/gifts/${encodeURIComponent(giftCode || '')}`);
    let gift = null;

    function updateGiftTitle() {
      if (gift) document.title = `TRACE #${gift.id} — ${i18n.t('homeMetaTitle')}`;
    }

    if (giftResponse.ok) {
      gift = await giftResponse.json();
      document.querySelector('[data-trace-number]').textContent = `TRACE #${gift.id}`;
      document.querySelector('input[name="gift"]').value = gift.code;
      updateGiftTitle();
      giftStatus.hidden = true;
      giftContent.hidden = false;
    } else {
      giftStatus.dataset.i18n = 'giftNotFound';
      giftStatus.textContent = i18n.t('giftNotFound');
    }

    const languageSelect = document.querySelector('[data-language-select]');
    const languageGate = document.querySelector('[data-language-gate]');
    const languageGateHeading = document.querySelector('#language-gate-heading');
    const form = document.querySelector('#trace-form');
    const photoInput = document.querySelector('#photo');
    const submitButton = form.querySelector('button[type="submit"]');
    const formStatus = form.querySelector('.form-status');
    const successIllustration = form.querySelector('[data-success-illustration]');

    function closeLanguageGate(language) {
      i18n.setLanguage(language, true);
      languageGate.hidden = true;
      document.body.classList.remove('language-gate-open');
      document.querySelector('.trace-intro h1')?.focus({ preventScroll: true });
    }

    if (i18n.hasSavedLanguage) {
      languageGate.hidden = true;
    } else {
      const browserLanguage = navigator.language?.slice(0, 2);
      const gateLanguage = i18n.translations[browserLanguage] ? browserLanguage : 'en';
      languageGate.lang = gateLanguage;
      languageGate.dir = gateLanguage === 'ar' ? 'rtl' : 'ltr';
      document.querySelector('[data-gate-i18n="welcome"]').textContent = i18n.t('welcome', gateLanguage);
      document.querySelector('[data-gate-i18n="chooseLanguage"]').textContent = i18n.t('chooseLanguage', gateLanguage);
      document.body.classList.add('language-gate-open');
      languageGateHeading.focus({ preventScroll: true });
    }

    document.querySelectorAll('[data-language-choice]').forEach((button) => {
      button.addEventListener('click', () => closeLanguageGate(button.dataset.languageChoice));
    });

    window.addEventListener('site-language-change', () => {
      updateGiftTitle();
      if (form.classList.contains('form--sending')) formStatus.textContent = i18n.t('sending');
      else if (formStatus.classList.contains('form-status--success')) formStatus.textContent = i18n.t('success');
      else if (formStatus.classList.contains('form-status--error')) formStatus.textContent = i18n.t('error');
    });

    function withTimeout(promise, milliseconds, fallback) {
      return new Promise((resolve, reject) => {
        const timer = window.setTimeout(() => {
          fallback === undefined ? reject(new Error('Timed out')) : resolve(fallback);
        }, milliseconds);

        promise.then(
          (value) => {
            window.clearTimeout(timer);
            resolve(value);
          },
          (error) => {
            window.clearTimeout(timer);
            reject(error);
          },
        );
      });
    }

    function loadPhoto(photo) {
      return new Promise((resolve, reject) => {
        const image = new Image();
        const url = URL.createObjectURL(photo);

        image.onload = () => {
          URL.revokeObjectURL(url);
          resolve(image);
        };
        image.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error('Could not read photo'));
        };
        image.src = url;
      });
    }

    async function resizePhoto(photo) {
      if (!photo) return photo;

      const image = await loadPhoto(photo);
      const scale = Math.min(1, 1800 / Math.max(image.naturalWidth, image.naturalHeight));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(image.naturalWidth * scale);
      canvas.height = Math.round(image.naturalHeight * scale);
      canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height);

      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.82));
      if (!blob) throw new Error('Could not prepare photo');
      return new File([blob], 'photo.jpg', { type: 'image/jpeg' });
    }

    function sendForm(formData) {
      return new Promise((resolve, reject) => {
        const upload = new XMLHttpRequest();
        upload.open('POST', form.action);
        upload.responseType = 'json';
        upload.timeout = 60000;
        upload.setRequestHeader('Accept', 'application/json');
        upload.onload = () => upload.status >= 200 && upload.status < 300
          ? resolve(upload.response)
          : reject(new Error(upload.response?.error || 'Submission failed'));
        upload.onerror = () => reject(new Error('Network error'));
        upload.ontimeout = () => reject(new Error('Upload timed out'));
        upload.onabort = () => reject(new Error('Upload cancelled'));
        upload.send(formData);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      submitButton.disabled = true;
      form.setAttribute('aria-busy', 'true');
      form.classList.add('form--sending');
      formStatus.classList.remove('form-status--success', 'form-status--error');
      successIllustration.hidden = true;
      formStatus.textContent = i18n.t('sending');

      try {
        const formData = new FormData(form);
        formData.set('language', languageSelect.value);

        if (photoInput.files[0]) {
          const photo = photoInput.files[0];
          formData.set('photo', await withTimeout(resizePhoto(photo), 15000, photo));
        }

        await sendForm(formData);

        const submittedLanguage = languageSelect.value;
        form.reset();
        languageSelect.value = submittedLanguage;
        formStatus.classList.add('form-status--success');
        successIllustration.hidden = false;
        formStatus.textContent = i18n.t('success');
        formStatus.focus({ preventScroll: true });
        formStatus.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        console.error(error);
        formStatus.classList.add('form-status--error');
        formStatus.textContent = i18n.t('error');
      } finally {
        form.removeAttribute('aria-busy');
        form.classList.remove('form--sending');
        submitButton.disabled = false;
      }
    });
  </script>
</Layout>
