---
import Layout from '../../layouts/Layout.astro';
import en from '../../i18n/en.json';
import ru from '../../i18n/ru.json';
import es from '../../i18n/es.json';
import fr from '../../i18n/fr.json';
import pt from '../../i18n/pt.json';
import ar from '../../i18n/ar.json';
import zh from '../../i18n/zh.json';
import hi from '../../i18n/hi.json';

const translations = { en, ru, es, fr, pt, ar, zh, hi };

---

<Layout
  title="A gift — Traces of Good People"
  description="A small gift travelling between good people."
>
  <p class="form-status" data-gift-status role="status">Loading gift…</p>
  <div data-gift-content hidden>
  <section class="language-picker">
    <label for="language" data-i18n="languageLabel">Language</label>
    <select id="language" name="language" form="trace-form">
      <option value="en">English</option>
      <option value="ru">Русский</option>
      <option value="es">Español</option>
      <option value="fr">Français</option>
      <option value="pt">Português</option>
      <option value="ar">العربية</option>
      <option value="zh">中文</option>
      <option value="hi">हिन्दी</option>
    </select>
  </section>

  <article class="trace-intro">
    <p class="trace-number" data-trace-number></p>
    <h1 data-i18n="heading">This gift found its way to you.</h1>
    <p class="intro" data-i18n="intro">
      It is part of a small travelling project about chance meetings and the
      good people we find along the way.
    </p>
  </article>

  <section class="feedback" aria-labelledby="feedback-heading">
    <div class="feedback-heading">
      <h2 id="feedback-heading" data-i18n="formHeading">Leave your trace</h2>
      <p data-i18n="formIntro">Share as much or as little as you like.</p>
    </div>

    <form id="trace-form" action="/api/traces" method="post" enctype="multipart/form-data">
      <input type="hidden" name="gift" />

      <div class="field">
        <label for="name">
          <span data-i18n="nameLabel">Name or nickname</span>
          <small data-i18n="optional">optional</small>
        </label>
        <input id="name" name="name" type="text" maxlength="80" autocomplete="nickname" />
      </div>

      <div class="field">
        <label for="location">
          <span data-i18n="locationLabel">City and country</span>
          <small data-i18n="optional">optional</small>
        </label>
        <input id="location" name="location" type="text" maxlength="120" autocomplete="address-level2" />
      </div>

      <div class="field">
        <label for="message" data-i18n="messageLabel">Your message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          maxlength="1000"
          aria-describedby="message-help"
          required
        ></textarea>
        <small id="message-help" data-i18n="messageHelp">
          Need an idea? Tell me something about yourself, what made you smile
          today, or what a traveller should see in your city.
        </small>
      </div>

      <div class="field">
        <label for="photo">
          <span data-i18n="photoLabel">Photo</span>
          <small data-i18n="optional">optional</small>
        </label>
        <input
          id="photo"
          name="photo"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          capture="environment"
        />
        <small data-i18n="photoHelp">Choose a photo or take one with your camera.</small>
      </div>

      <aside class="privacy-notice">
        <h3 data-i18n="privacyHeading">Before you submit</h3>
        <p data-i18n="privacyText">
          Do not share sensitive or private information such as your home
          address, phone number, identification documents, passwords, or
          financial information.
        </p>
      </aside>

      <label class="consent">
        <input type="checkbox" name="consent" value="yes" required />
        <span data-i18n="consentLabel">
          I understand that my message and photo may become publicly visible
          after moderation.
        </span>
      </label>

      <button type="submit" data-i18n="submit">Send trace</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  </div>
  <script type="application/json" id="translations" set:html={JSON.stringify(translations)} />
  <script>
    const giftStatus = document.querySelector('[data-gift-status]');
    const giftContent = document.querySelector('[data-gift-content]');
    const giftCode = location.pathname.split('/').filter(Boolean).at(-1)?.toUpperCase();
    const giftResponse = await fetch(`/api/gifts/${encodeURIComponent(giftCode || '')}`);

    if (giftResponse.ok) {
      const gift = await giftResponse.json();
      document.querySelector('[data-trace-number]').textContent = `TRACE #${gift.id}`;
      document.querySelector('input[name="gift"]').value = gift.code;
      document.title = `TRACE #${gift.id} — Traces of Good People`;
      giftStatus.hidden = true;
      giftContent.hidden = false;
    } else {
      giftStatus.textContent = 'Gift not found.';
    }

    const languageSelect = document.querySelector('#language');
    const translationsElement = document.querySelector('#translations');
    const translations = JSON.parse(translationsElement.textContent);
    const form = document.querySelector('#trace-form');
    const photoInput = document.querySelector('#photo');
    const submitButton = form.querySelector('button[type="submit"]');
    const formStatus = form.querySelector('.form-status');

    function setLanguage(language) {
      const selected = translations[language] || translations.en;

      document.documentElement.lang = translations[language] ? language : 'en';
      document.documentElement.dir = language === 'ar' ? 'rtl' : 'ltr';

      document.querySelectorAll('[data-i18n]').forEach((element) => {
        const translation = selected[element.dataset.i18n];

        if (translation) {
          element.textContent = translation;
        }
      });
    }

    languageSelect.addEventListener('change', () => setLanguage(languageSelect.value));

    async function resizePhoto(photo) {
      if (!photo || !photo.type.startsWith('image/')) return photo;

      const image = await createImageBitmap(photo);
      const scale = Math.min(1, 1800 / Math.max(image.width, image.height));

      if (scale === 1 && photo.type === 'image/webp') {
        image.close();
        return photo;
      }

      const canvas = document.createElement('canvas');
      canvas.width = Math.round(image.width * scale);
      canvas.height = Math.round(image.height * scale);
      canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height);
      image.close();

      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.82));
      return blob ? new File([blob], 'photo.webp', { type: 'image/webp' }) : photo;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const selected = translations[languageSelect.value] || translations.en;
      submitButton.disabled = true;
      formStatus.textContent = selected.sending;

      try {
        const formData = new FormData(form);
        formData.set('language', languageSelect.value);

        if (photoInput.files[0]) {
          formData.set('photo', await resizePhoto(photoInput.files[0]));
        }

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Submission failed');

        form.reset();
        formStatus.textContent = selected.success;
      } catch (error) {
        console.error(error);
        formStatus.textContent = selected.error;
      } finally {
        submitButton.disabled = false;
      }
    });
  </script>
</Layout>
